generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id               Int               @id @default(autoincrement())
  nome             String
  email            String            @unique
  areaInteresse    String
  createdAt        DateTime          @default(now())
  termsAcceptances TermsAcceptance[]
}

// Histórico de aceitações dos Termos de Uso: uma linha por (lead, versão).
// Aceitar uma versão nova cria outra linha, sem apagar as anteriores.
model TermsAcceptance {
  id           Int      @id @default(autoincrement())
  leadId       Int
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  termsVersion String
  acceptedAt   DateTime @default(now())

  @@unique([leadId, termsVersion])
  @@index([leadId, acceptedAt])
}
