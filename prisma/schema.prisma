generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  areasInteresse String[]
  createdAt     DateTime @default(now())
  // Preenchido quando o e-mail de lançamento sai, para que um novo disparo
  // (cron ou manual) não envie duas vezes para o mesmo lead.
  emailLancamentoEnviadoEm DateTime?
}

// Usuário da plataforma, autenticado pelo NextAuth (provider de credenciais).
// A senha nunca é guardada em texto puro: só o hash bcrypt.
model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  // Copiadas do pré-cadastro (Lead) com o mesmo e-mail, quando existe.
  areasInteresse String[] @default([])

  // Perfil público-profissional, editado em /perfil/editar. Todos opcionais:
  // null = a pessoa não preencheu ou apagou o campo.
  profissao   String?
  // Localização em campos separados para cruzar com o conteúdo regional.
  // `estado` é a UF ("SP"); `cidade` como a pessoa digitou ("Campinas").
  cidade      String?
  estado      String?
  // Legado (texto livre), substituído por cidade/estado e não usado pelo app.
  // Fica até a próxima migration para não quebrar a versão já publicada.
  localizacao String?
  sobre       String?
  linkedinUrl String?
  githubUrl   String?
  siteUrl     String?

  // Foto já recortada e reduzida no navegador (quadrada, ~400px), guardada no
  // próprio banco para não depender de um serviço de storage. Nunca selecione
  // `foto` sem precisar: só a rota GET /api/perfil/foto lê os bytes.
  foto             Bytes?
  fotoTipo         String?
  // Muda a cada troca de foto; vai na URL (?v=) para furar o cache do navegador.
  fotoAtualizadaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topicosConcluidos ProgressoTopico[]
}

// Cada linha é um tópico de roadmap que o usuário marcou como concluído. Os
// roadmaps vivem em src/data/roadmaps.json, então roadmapId e topicId são os
// ids de lá (não há tabela de roadmap).
model ProgressoTopico {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId   String
  topicId     String
  concluidoEm DateTime @default(now())

  @@unique([userId, roadmapId, topicId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Roadmaps (conteúdo das trilhas). Os ids são os slugs de src/data/roadmaps.json,
// para o seed poder rodar de novo sem duplicar e as URLs ficarem estáveis.
// ---------------------------------------------------------------------------

model Roadmap {
  id        String   @id // slug, ex.: "analista-de-dados"
  titulo    String
  descricao String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  etapas    Etapa[]

  conteudosRegionais ConteudoRegional[]
}

// Etapa da trilha (Fundamentos, Intermediário, ...), exibida na ordem de `ordem`.
model Etapa {
  id        String   @id
  roadmapId String
  nome      String
  ordem     Int
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topicos   Topico[]

  @@index([roadmapId, ordem])
}

model Topico {
  id        String      @id
  etapaId   String
  titulo    String
  descricao String
  nivel     NivelTopico
  ordem     Int
  // [{ tipo: "conceito" | "ferramenta" | "framework", nome: string }]
  // Só é exibido, por isso fica em JSON em vez de tabela própria.
  recursos  Json        @default("[]")
  etapa     Etapa       @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@index([etapaId, ordem])
}

enum NivelTopico {
  essencial
  recomendado
  opcional
}

// ---------------------------------------------------------------------------
// Conteúdo regional: o que existe perto da pessoa para ela avançar na trilha
// (cursos, empresas, eventos e comunidades). Cada item tem uma região e se
// liga às trilhas em que faz sentido, para o app mostrar "perto de você" o que
// combina com o que ela estuda.
// ---------------------------------------------------------------------------

model ConteudoRegional {
  id         String               @id @default(cuid())
  tipo       TipoConteudoRegional
  titulo     String
  descricao  String
  url        String?
  modalidade Modalidade           @default(presencial)

  // Região. `estado` é a UF em maiúsculas ("SP"); `cidade` null = vale para o
  // estado todo; os dois null = nacional (ex.: curso ou comunidade online).
  estado String?
  cidade String?

  // null = não informado.
  gratuito Boolean?

  // Período, para eventos e turmas de curso. Fora disso, ficam null.
  inicioEm DateTime?
  fimEm    DateTime?

  // Esconde o item sem apagar (evento cancelado, empresa que fechou...).
  ativo Boolean @default(true)

  // Trilhas relacionadas. Vazio = serve para qualquer trilha.
  roadmaps Roadmap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, cidade])
  @@index([tipo])
}

enum TipoConteudoRegional {
  curso
  empresa
  evento
  comunidade
}

enum Modalidade {
  presencial
  online
  hibrido
}
