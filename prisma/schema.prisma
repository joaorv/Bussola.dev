generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  areaInteresse String
  createdAt     DateTime @default(now())
  // Preenchido quando o e-mail de lançamento sai, para que um novo disparo
  // (cron ou manual) não envie duas vezes para o mesmo lead.
  emailLancamentoEnviadoEm DateTime?
}

// Usuário da plataforma, autenticado pelo NextAuth (provider de credenciais).
// A senha nunca é guardada em texto puro: só o hash bcrypt.
model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
