# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

# Connection string do banco PostgreSQL (Neon, Render, Railway, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/bussola_dev"

# Chave usada pelo NextAuth.js para assinar sessões/tokens.
# Gere uma com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-chave-secreta"

# URL onde a aplicação está rodando (em dev, geralmente localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# Data de lançamento usada pelo contador regressivo da landing page.
# ISO 8601 com fuso explícito (-03:00 = horário de Brasília).
# Precisa do prefixo NEXT_PUBLIC_ porque o contador roda no navegador.
NEXT_PUBLIC_LAUNCH_DATE="2026-11-05T00:00:00-03:00"
